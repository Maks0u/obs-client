{
    "name": "obs-client",
    "version": "1.2.0",
    "author": "Maks0u",
    "license": "MIT",
    "description": "Wrapper for obs-websocket-js",
    "keywords": [
        "obs",
        "twitch",
        "stream",
        "streaming",
        "dashboard",
        "deck",
        "websocket"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "test": "node --env-file=.env ./node_modules/.bin/mocha --timeout 10000",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "format": "biome format --write ."
    },
    "dependencies": {
        "obs-websocket-js": "^5.0.8"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@tsconfig/node26": "^26.0.1",
        "@types/node": "^26.6.6",
        "mocha": "^12.0.3",
        "typescript": "^7.0.2"
    }
}
